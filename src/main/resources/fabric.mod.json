		"client": ["com.example.dupebutton.DupeButtonClient"]
	},
	"mixins": ["dupebutton.mixins.json"],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": "*"
	}
}
